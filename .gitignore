# Клоны ботов: их тянет ферма (source.prepare) в bots/. Исходники чужих
# репозиториев в этом проекте не хранятся.
bots/

# Окружения ботов: по venv на бота, восстанавливаются из его pyproject.
envs/

# Состояние прогонов: базы SQLite создаются заново на каждый кейс.
.work/

# Отчёты и кадры: результаты прогонов, а не исходники. В git не идут —
// отчёт содержит текст, который прислал бот, и он может быть ПДн.
reports/

# Подложка кадра — снимок окна Telegram, личный файл владельца.
# Пример с заглушкой лежит в assets/README.md, сам снимок игнорируется.
# Личный снимок окна в git не идёт; placeholder.png — заглушка для CI, она нужна.
assets/tg-bg.*
!assets/placeholder.png

# Секреты — никогда в репозиторий.
.env
.env.*
*.age
*.session
*.csv

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Инструменты и кэш
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.sqlite
*.db